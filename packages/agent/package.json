{
  "name": "@exam-prep/agent",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./src/hub/index.js": "./dist/hub/index.js",
    "./src/progress.js": "./dist/progress.js",
    "./src/*": "./dist/*.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "dev:server": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@lancedb/lancedb": "^0.39.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.14",
    "@langchain/textsplitters": "^1.0.2",
    "@tavily/core": "^0.7.2",
    "apache-arrow": "^18.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "vitest": "^5.0.3"
  }
}
